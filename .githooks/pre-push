#!/usr/bin/env bash
# Refuse de pousser un tag vX.Y.Z dont le commit n'a pas la version X.Y.Z dans
# tous les fichiers (voir verifier-tag) : cas d'un tag créé sans le hook
# reference-transaction. Installé par ./dev.sh (git config core.hooksPath .githooks).
zero="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"
status=0
while read -r local_ref local_object _remote_ref _remote_object; do
    [[ "$local_ref" == refs/tags/v* && "$local_object" != "$zero" ]] || continue
    "$(dirname "$0")/verifier-tag" "$local_ref" "$local_object" || status=1
done
exit "$status"
